{
  "name": "huddle",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "huddle": "tsx apps/huddle/src/huddle.ts",
    "huddle:build:release": "pnpm --filter huddle-cli build:release",
    "huddle:package:homebrew": "pnpm --filter huddle-cli package:homebrew",
    "huddle:package:macos": "pnpm --filter huddle-cli package:macos",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "oxlint": "^1.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
